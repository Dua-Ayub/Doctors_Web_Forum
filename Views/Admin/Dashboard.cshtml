@model List<Doctors_Web_Forum.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="admin-shell">

  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="admin-logo"><span class="cross"></span> DocPanel Admin</div>
    <nav>
      <a href="/Admin/Dashboard" class="active">Dashboard</a>
    </nav>
    <div class="admin-logout">
      <a href="/Admin/Logout">Logout →</a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="admin-main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
    <div class="admin-topbar">
      <div>
        <h1>Dashboard</h1>
        <p>Manage registered doctors and verification requests.</p>
      </div>
    </div>

    <div class="admin-stats">
      <div class="admin-stat-card">
        <div class="stat-label">Total Doctors</div>
        <div class="stat-value">@ViewBag.TotalUsers</div>
      </div>
      <div class="admin-stat-card verified">
        <div class="stat-label">Verified</div>
        <div class="stat-value">@ViewBag.VerifiedUsers</div>
      </div>
      <div class="admin-stat-card pending">
        <div class="stat-label">Pending Verification</div>
        <div class="stat-value">@ViewBag.PendingUsers</div>
      </div>
    </div>

    <form method="get" asp-controller="Admin" asp-action="Dashboard" class="admin-search">
      <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Search by name or email...">
      <button type="submit" class="btn btn-primary">Search</button>
      @if (!string.IsNullOrWhiteSpace((string)ViewBag.SearchTerm))
      {
        <a href="/Admin/Dashboard" class="btn btn-outline">Clear</a>
      }
    </form>

    <div class="admin-table-card">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Specialty</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Count == 0)
          {
            <tr>
              <td colspan="5" style="text-align:center; color:var(--color-muted); padding:30px;">No doctors found.</td>
            </tr>
          }
          @foreach (var user in Model)
          {
            <tr>
              <td>@user.FullName</td>
              <td>@user.Email</td>
              <td>@user.Specialty</td>
              <td>
                @if (user.IsVerified)
                {
                  <span class="status-pill status-answered"><span class="dot"></span>Verified</span>
                }
                else
                {
                  <span class="status-pill status-open"><span class="dot"></span>Pending</span>
                }
              </td>
              <td>
                                <div class="admin-actions">

                                    @if (!user.IsVerified)
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="Verify"
                                              asp-route-id="@user.Id"
                                              method="post">
                                            <button type="submit" class="btn-verify">
                                                Verify
                                            </button>
                                        </form>
                                    }

                                    <form asp-controller="Admin"
                                          asp-action="Delete"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');">

                                        <button type="submit" class="btn-delete-admin">
                                            Delete
                                        </button>

                                    </form>

                                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </main>
</div>