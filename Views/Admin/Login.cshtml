@{
    ViewData["Title"] = "Admin Login";
    Layout = "_AdminLayout";
}

<div class="admin-login-wrap">
  <div class="admin-login-card">
    <div class="admin-badge"></div>
    <h2>Admin Portal</h2>
    <p class="admin-subtitle">DocPanel Administration</p>

    @if (ViewBag.Error != null)
    {
      <p style="color:#C6493D; font-weight:600; font-size:0.85rem; margin-bottom:14px; text-align:center;">@ViewBag.Error</p>
    }

    <form asp-controller="Admin" asp-action="Login" method="post">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>
  </div>
</div>