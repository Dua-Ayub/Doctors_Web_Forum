@model IEnumerable<Doctors_Web_Forum.Models.Question>

@{
    ViewData["Title"] = "My Questions";
    Layout = "_Layout";
}

<section class="questions-section">

    <div class="home-container">

        <h2>My Questions</h2>

        @if (Model.Any())
        {
            foreach (var question in Model)
            {
                <div class="question-card">

                    <h3>@question.Title</h3>

                    <p>@question.Description</p>

                    <div class="question-meta">
                        <span>🩺 @question.Specialty.Name</span>
                        <span>👁 @question.View Views</span>
                        <span>📅 @question.CreatedAt.ToShortDateString()</span>
                    </div>

                    <a asp-action="Details"
                       asp-route-id="@question.Id"
                       class="btn btn-primary">
                        View Details
                    </a>

                </div>
            }
        }
        else
        {
            <p>You haven't posted any questions yet.</p>
        }

    </div>

</section>